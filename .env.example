# Copy these into your hosting provider's environment variables (e.g. Vercel → Settings → Environment Variables).
# Do not put real keys in .env.local: that file is committed to this repository.

# Contact form email delivery (https://resend.com)
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Mulligan CT Website <website@mulliganrecoveryct.com>"
CONTACT_FROM_EMAIL=
# Optional: defaults to admissions@mulliganrecoveryct.com
CONTACT_TO_EMAIL=
